POSTGRES_PASSWORD=cambia_esto
# Carpeta con orig/ enh/ json/ summary/ que lee el panel.
#   ./demo_data = datos sinteticos de demostracion (vienen en el repo)
#   ./data      = resultados reales generados por el equipo
HOST_DATA_DIR=./demo_data
WEB_PORT=80

# Clave para que el nodo con GPU envie resultados al panel (POST /api/ingest).
# Vacia = ingesta deshabilitada. Generar:  openssl rand -hex 24
# Si la usas, pon HOST_DATA_DIR=./data para no ensuciar demo_data (que vive en git).
INGEST_TOKEN=
